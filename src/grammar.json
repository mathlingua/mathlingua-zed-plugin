{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "mathlingua",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_token"
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          }
        ]
      }
    },
    "_newline": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\n"
      }
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "bullet"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "backtick_op"
        },
        {
          "type": "SYMBOL",
          "name": "type_command"
        },
        {
          "type": "SYMBOL",
          "name": "command"
        },
        {
          "type": "SYMBOL",
          "name": "alias_ref"
        },
        {
          "type": "SYMBOL",
          "name": "person_ref"
        },
        {
          "type": "SYMBOL",
          "name": "magnetic_placeholder"
        },
        {
          "type": "SYMBOL",
          "name": "placeholder"
        },
        {
          "type": "SYMBOL",
          "name": "assign_op"
        },
        {
          "type": "SYMBOL",
          "name": "is_op"
        },
        {
          "type": "SYMBOL",
          "name": "header"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "_punct"
        }
      ]
    },
    "bullet": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\.[ \\t]"
        }
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\\\n]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\."
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "backtick_op": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "`[^`\\n]+`"
        }
      }
    },
    "type_command": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\\\\"
            },
            {
              "type": "PATTERN",
              "value": "[a-zA-Z_][a-zA-Z0-9_]*"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": ":"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[a-zA-Z_][a-zA-Z0-9_]*"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "command": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "command_head"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "command_label"
                },
                {
                  "type": "SYMBOL",
                  "name": "command_brace_args"
                },
                {
                  "type": "SYMBOL",
                  "name": "command_paren_args"
                }
              ]
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "command_close"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "command_head": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\\"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "."
                    },
                    {
                      "type": "STRING",
                      "value": ":"
                    }
                  ]
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[a-zA-Z_$][a-zA-Z0-9_$]*"
                },
                {
                  "type": "PATTERN",
                  "value": "[!%^&*+\\-=|<>~]+"
                }
              ]
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "."
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "PATTERN",
                        "value": "[a-zA-Z_$][a-zA-Z0-9_$]*"
                      },
                      {
                        "type": "PATTERN",
                        "value": "[!%^&*+\\-=|<>~]+"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "command_close": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ":/"
            },
            {
              "type": "STRING",
              "value": "./"
            },
            {
              "type": "STRING",
              "value": "?:/"
            }
          ]
        }
      }
    },
    "command_label": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "command_label_marker"
        },
        {
          "type": "SYMBOL",
          "name": "command_label_name"
        }
      ]
    },
    "command_label_marker": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ":?"
            },
            {
              "type": "STRING",
              "value": ":"
            }
          ]
        }
      }
    },
    "command_label_name": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z_$][a-zA-Z0-9_$]*"
      }
    },
    "command_brace_args": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "STRING",
              "value": "{"
            }
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_token"
            }
          },
          {
            "type": "STRING",
            "value": "}"
          }
        ]
      }
    },
    "command_paren_args": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "STRING",
              "value": "("
            }
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_token"
            }
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    },
    "alias_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "\\$([a-zA-Z_][a-zA-Z0-9_]*|`[^`\\n]+`)(\\.([a-zA-Z_][a-zA-Z0-9_]*|`[^`\\n]+`))*"
        }
      }
    },
    "person_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "@([a-zA-Z_][a-zA-Z0-9_]*|`[^`\\n]+`)(\\.([a-zA-Z_][a-zA-Z0-9_]*|`[^`\\n]+`))*"
        }
      }
    },
    "magnetic_placeholder": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "[a-zA-Z][a-zA-Z0-9_]*__"
        }
      }
    },
    "placeholder": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[a-zA-Z][a-zA-Z0-9_]*_"
        }
      }
    },
    "assign_op": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "::="
            },
            {
              "type": "STRING",
              "value": ":=:"
            },
            {
              "type": "STRING",
              "value": ":="
            },
            {
              "type": "STRING",
              "value": ":->"
            },
            {
              "type": "STRING",
              "value": "|->"
            },
            {
              "type": "STRING",
              "value": "->"
            }
          ]
        }
      }
    },
    "is_op": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "is_not?"
            },
            {
              "type": "STRING",
              "value": "is_not"
            },
            {
              "type": "STRING",
              "value": "is?"
            },
            {
              "type": "STRING",
              "value": "is"
            },
            {
              "type": "STRING",
              "value": "via"
            },
            {
              "type": "STRING",
              "value": "member_of"
            }
          ]
        }
      }
    },
    "header": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[a-zA-Z][a-zA-Z0-9_]*:"
        }
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9]+(\\.[0-9]+)?"
      }
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[!%^&*+\\-=|<>/~]+(_[a-zA-Z][a-zA-Z0-9_]*)?"
      }
    },
    "identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z][a-zA-Z0-9_]*"
      }
    },
    "_punct": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "STRING",
          "value": "}"
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "STRING",
          "value": ";"
        },
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "STRING",
          "value": "?"
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "STRING",
          "value": "/"
        },
        {
          "type": "STRING",
          "value": "\\"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r]+"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}
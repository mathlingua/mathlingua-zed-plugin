{
  "name": "tree-sitter-mathlingua",
  "version": "0.0.1",
  "description": "Mathlingua grammar for tree-sitter",
  "main": "bindings/node",
  "keywords": [
    "parser",
    "mathlingua",
    "tree-sitter"
  ],
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.22.0"
  },
  "tree-sitter": [
    {
      "scope": "source.mathlingua",
      "file-types": [
        "mlg"
      ],
      "highlights": "queries/highlights.scm"
    }
  ]
}
